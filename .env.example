# Azure App Registration
CLIENT_ID=your-app-client-id
CLIENT_SECRET=your-app-client-secret
TENANT_ID=your-azure-tenant-id

# Public URL of this server (used for OAuth redirect URI)
# For local dev: http://localhost:8000
# For production: must be HTTPS
BASE_URL=http://localhost:8000

# Comma-separated list of allowed CORS origins
# Include http://localhost:6274 for MCP Inspector during local dev
ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:6274"]

# Require FastMCP's extra client consent prompt per MCP client. (default: true)
# Prevents confused-deputy attacks by requiring users to explicitly approve each new
# client. Keep true in production; set false only for local dev with throwaway
# clients. Docs: https://gofastmcp.com/servers/auth/oauth-proxy#param-require-authorization-consent
# REQUIRE_AUTHORIZATION_CONSENT=true

# Optional rate-limit overrides (per client sliding window)
# Defaults are 120 requests per 1 minute
# RATE_LIMIT_MAX_REQUESTS=120
# RATE_LIMIT_WINDOW_MINUTES=1

# Optional: keep OAuth state (client registrations, users' tokens) in Redis so
# sign-ins survive container recreation, scale-to-zero and multiple replicas.
# Unset = encrypted file store inside the container (lost on recreation).
# rediss:// = TLS (required by Azure Redis); the path is the DB index.
# REDIS_URL contains a credential — keep it in a secret, not in source control.
# Enabling it (or setting JWT_SIGNING_KEY) signs every user out once.
# Docs: https://gofastmcp.com/servers/auth/oauth-proxy
# REDIS_URL=redis://localhost:6379/1

# Fixed token-signing secret, so rotating CLIENT_SECRET doesn't sign everyone
# out. Same value on every replica. Default: derived from CLIENT_SECRET.
# JWT_SIGNING_KEY=

# Fernet key for the Redis store. Requires REDIS_URL. Default: derived like
# FastMCP's own store key. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STORAGE_ENCRYPTION_KEY=
